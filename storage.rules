rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Story images: publicly viewable, uploadable by any signed-in (anonymous)
    // visitor as long as it matches the same type/size limits the app enforces
    // client-side — but here they're actually verified server-side.
    match /historie-bilder/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
